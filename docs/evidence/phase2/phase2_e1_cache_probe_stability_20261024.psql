\set ON_ERROR_STOP on
\pset pager off
DO $guard$ BEGIN IF current_database()<>'vnsignal_phase2_report_20261019' THEN RAISE EXCEPTION 'wrong database'; END IF; END $guard$;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout='30min';
SET LOCAL temp_file_limit='90GB';
SET LOCAL work_mem='128MB';
SET LOCAL jit=off;
SET LOCAL synchronous_commit=off;
SET LOCAL random_page_cost=1.1;
SET LOCAL vnpipe.phase2_symbol_batch_size='60';
SET LOCAL vnpipe.phase2_cache_time_budget_minutes='40';
SET LOCAL application_name='phase2_e1_cache_probe_stability';
SELECT 'warmup_15' AS sample,* FROM feat.probe_phase2_adjustment_cache(15);
SELECT 'warmup_30' AS sample,* FROM feat.probe_phase2_adjustment_cache(30);
SELECT 'warmup_60' AS sample,* FROM feat.probe_phase2_adjustment_cache(60);
SELECT 'measured_15' AS sample,* FROM feat.probe_phase2_adjustment_cache(15);
SELECT 'measured_30' AS sample,* FROM feat.probe_phase2_adjustment_cache(30);
SELECT 'measured_60' AS sample,* FROM feat.probe_phase2_adjustment_cache(60);
SELECT feat.assert_phase2_adjustment_cache_scaling();
ROLLBACK;