\set ON_ERROR_STOP on
\pset pager off
DO $guard$ BEGIN IF current_database()<>'vnsignal_phase2_report_20261019' THEN RAISE EXCEPTION 'wrong database'; END IF; END $guard$;
LOAD 'auto_explain';
BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout='5min';
SET LOCAL temp_file_limit='90GB';
SET LOCAL work_mem='32MB';
SET LOCAL jit=off;
SET LOCAL synchronous_commit=off;
SET LOCAL random_page_cost=1.1;
SET LOCAL application_name='phase2_e1_cache_probe_nested_plan';
SET LOCAL auto_explain.log_min_duration='0';
SET LOCAL auto_explain.log_analyze=on;
SET LOCAL auto_explain.log_buffers=on;
SET LOCAL auto_explain.log_timing=off;
SET LOCAL auto_explain.log_verbose=on;
SET LOCAL auto_explain.log_nested_statements=on;
SELECT pg_backend_pid() AS diagnostic_backend_pid;
SELECT temp_files,temp_bytes AS temp_bytes_before FROM pg_stat_database WHERE datname=current_database();
\timing on
SELECT feat.begin_phase2_adjustment_rows(60,60) AS begin_batches;
SELECT feat.populate_phase2_adjustment_rows(0) AS populated_rows;
SELECT feat.finish_phase2_adjustment_rows() AS finalized_rows;
SELECT pg_stat_force_next_flush();
SELECT temp_files,temp_bytes AS temp_bytes_after FROM pg_stat_database WHERE datname=current_database();
ROLLBACK;