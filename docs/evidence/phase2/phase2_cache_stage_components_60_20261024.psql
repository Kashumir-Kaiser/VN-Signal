\set ON_ERROR_STOP on
\pset pager off

-- Rollback-only component timing and nested-plan capture for the cache stage.
DO $$
BEGIN
    IF current_database()<>'vnsignal_phase2_report_20261019' THEN
        RAISE EXCEPTION 'cache component probe is restricted to the disposable report clone; got %',current_database();
    END IF;
END $$;

LOAD 'auto_explain';
SET auto_explain.log_min_duration='0';
SET auto_explain.log_nested_statements=on;
SET auto_explain.log_analyze=on;
SET auto_explain.log_buffers=on;
SET auto_explain.log_verbose=on;
SET auto_explain.log_level='DEBUG1';
SET client_min_messages='DEBUG1';

BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout='10min';
SET LOCAL temp_file_limit='90GB';
SET LOCAL work_mem='32MB';
SET LOCAL jit=off;
SET LOCAL synchronous_commit=off;
SET LOCAL random_page_cost=1.1;
SET LOCAL enable_nestloop=off;
SET LOCAL log_temp_files=0;
SET LOCAL application_name='phase2_cache_stage_components_60';

SELECT temp_files,temp_bytes FROM pg_stat_database WHERE datname=current_database();
SELECT feat.begin_phase2_adjustment_rows(60,60);
DO $phase2_cache_components$
DECLARE
    v_started timestamptz;
    v_rows bigint;
BEGIN
    v_started:=clock_timestamp();
    v_rows:=feat.populate_phase2_adjustment_rows(0);
    RAISE NOTICE 'CACHE COMPONENT populate rows=% elapsed=%',v_rows,clock_timestamp()-v_started;

    v_started:=clock_timestamp();
    v_rows:=feat.finish_phase2_adjustment_rows();
    RAISE NOTICE 'CACHE COMPONENT finalize rows=% elapsed=%',v_rows,clock_timestamp()-v_started;
END;
$phase2_cache_components$;
SELECT count(*) AS cache_rows FROM pg_temp.phase2_adjustment_rows;
ROLLBACK;
SELECT temp_files,temp_bytes FROM pg_stat_database WHERE datname=current_database();
