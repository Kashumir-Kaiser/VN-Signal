\set ON_ERROR_STOP on
\pset pager off
\timing on
DO $guard$ BEGIN
    IF current_database() <> 'vnsignal_phase2_report_20261019' THEN
        RAISE EXCEPTION 'wrong database: %', current_database();
    END IF;
END $guard$;
SET application_name = 'phase2_hash_date_order_probe';
SET statement_timeout = '20min';
SET temp_file_limit = '8GB';
SET work_mem = '64MB';
SET jit = off;

BEGIN;
SELECT feat.begin_phase2_adjustment_rows(60);
SELECT format(
    'SELECT feat.populate_phase2_adjustment_rows(%s);',
    batch_no
)
FROM (
    SELECT DISTINCT batch_no
    FROM pg_temp.phase2_adjustment_symbol_batches
    ORDER BY batch_no
) batches
\gexec
SELECT feat.finish_phase2_adjustment_rows();

CREATE TEMP TABLE phase2_hash_probe_dates(
    trade_date date PRIMARY KEY
) ON COMMIT DROP;
INSERT INTO pg_temp.phase2_hash_probe_dates(trade_date)
SELECT trade_date
FROM core.effective_trading_sessions
WHERE is_session
  AND trade_date BETWEEN DATE '2021-03-09' AND DATE '2025-12-31'
ORDER BY trade_date
LIMIT 12;
ANALYZE pg_temp.phase2_hash_probe_dates;

-- Measure the current symbol-batch physical layout.
EXPLAIN (ANALYZE, BUFFERS, SETTINGS, SUMMARY, TIMING)
SELECT r.trade_date,
       ops.phase2_hash_text(
           string_agg(to_jsonb(r)::text, E'\n' ORDER BY r.symbol_id)
       )
FROM pg_temp.phase2_hash_probe_dates d
JOIN pg_temp.phase2_adjustment_rows r ON r.trade_date = d.trade_date
GROUP BY r.trade_date;

CREATE TEMP TABLE phase2_adjustment_rows_date_sorted ON COMMIT DROP AS
SELECT *
FROM pg_temp.phase2_adjustment_rows
ORDER BY trade_date, symbol_id;
CREATE INDEX phase2_adjustment_rows_date_sorted_idx
    ON pg_temp.phase2_adjustment_rows_date_sorted(trade_date, symbol_id);
ANALYZE pg_temp.phase2_adjustment_rows_date_sorted;

-- Measure the same aggregate after one-time physical ordering by date.
EXPLAIN (ANALYZE, BUFFERS, SETTINGS, SUMMARY, TIMING)
SELECT r.trade_date,
       ops.phase2_hash_text(
           string_agg(to_jsonb(r)::text, E'\n' ORDER BY r.symbol_id)
       )
FROM pg_temp.phase2_hash_probe_dates d
JOIN pg_temp.phase2_adjustment_rows_date_sorted r
  ON r.trade_date = d.trade_date
GROUP BY r.trade_date;

CREATE TEMP TABLE phase2_hash_probe_baseline ON COMMIT DROP AS
SELECT r.trade_date,
       ops.phase2_hash_text(
           string_agg(to_jsonb(r)::text, E'\n' ORDER BY r.symbol_id)
       ) AS day_sha256
FROM pg_temp.phase2_hash_probe_dates d
JOIN pg_temp.phase2_adjustment_rows r ON r.trade_date = d.trade_date
GROUP BY r.trade_date;
CREATE TEMP TABLE phase2_hash_probe_sorted ON COMMIT DROP AS
SELECT r.trade_date,
       ops.phase2_hash_text(
           string_agg(to_jsonb(r)::text, E'\n' ORDER BY r.symbol_id)
       ) AS day_sha256
FROM pg_temp.phase2_hash_probe_dates d
JOIN pg_temp.phase2_adjustment_rows_date_sorted r
  ON r.trade_date = d.trade_date
GROUP BY r.trade_date;

SELECT count(*) AS baseline_hash_rows FROM pg_temp.phase2_hash_probe_baseline;
SELECT count(*) AS sorted_hash_rows FROM pg_temp.phase2_hash_probe_sorted;
SELECT count(*) AS differing_hash_rows
FROM (
    (SELECT * FROM pg_temp.phase2_hash_probe_baseline
     EXCEPT ALL
     SELECT * FROM pg_temp.phase2_hash_probe_sorted)
    UNION ALL
    (SELECT * FROM pg_temp.phase2_hash_probe_sorted
     EXCEPT ALL
     SELECT * FROM pg_temp.phase2_hash_probe_baseline)
) differences;

ROLLBACK;
