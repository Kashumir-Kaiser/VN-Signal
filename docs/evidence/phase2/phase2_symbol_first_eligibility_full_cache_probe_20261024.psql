\set ON_ERROR_STOP on
\pset pager off

-- Rollback-only full-cache scaling probe for migration 068's V3 eligibility
-- lookup. The selected input symbols grow 15 -> 30 -> 60; all 2.84M cache
-- rows remain available to each query, matching the production cache scope.
DO $$
BEGIN
    IF current_database()<>'vnsignal_phase2_report_20261019' THEN
        RAISE EXCEPTION 'full-cache eligibility probe is restricted to the disposable report clone; got %',current_database();
    END IF;
END $$;

BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout='30min';
SET LOCAL temp_file_limit='90GB';
SET LOCAL work_mem='32MB';
SET LOCAL jit=off;
SET LOCAL synchronous_commit=off;
SET LOCAL random_page_cost=1.1;
SET LOCAL vnpipe.phase2_symbol_batch_size='60';
SET LOCAL vnpipe.phase2_cache_time_budget_minutes='40';
SET LOCAL application_name='phase2_probe_symbol_first_eligibility';

SELECT feat.begin_phase2_adjustment_rows(60);
SELECT format('SELECT feat.populate_phase2_adjustment_rows(%s);',batch_no)
FROM (
    SELECT DISTINCT batch_no
    FROM pg_temp.phase2_adjustment_symbol_batches
    ORDER BY batch_no
) batches
\gexec
SELECT feat.finish_phase2_adjustment_rows();

CREATE TEMP TABLE phase2_v3_sessions ON COMMIT DROP AS
WITH prior_sessions AS MATERIALIZED (
    SELECT trade_date,row_number() OVER(ORDER BY trade_date DESC) AS prior_no
    FROM core.effective_trading_sessions
    WHERE trade_date<DATE '2020-01-01' AND is_session
), requested_sessions AS MATERIALIZED (
    SELECT trade_date FROM core.effective_trading_sessions
    WHERE trade_date BETWEEN DATE '2020-01-01' AND DATE '2020-03-31' AND is_session
), bounded AS MATERIALIZED (
    SELECT trade_date FROM requested_sessions
    UNION
    SELECT trade_date FROM prior_sessions WHERE prior_no<=1000
)
SELECT trade_date,row_number() OVER(ORDER BY trade_date)::bigint AS session_no
FROM bounded;
CREATE UNIQUE INDEX phase2_v3_sessions_date_idx ON pg_temp.phase2_v3_sessions(trade_date);
ANALYZE pg_temp.phase2_v3_sessions;

\echo ELIGIBILITY SCALE 15 INPUT SYMBOLS
EXPLAIN (ANALYZE,BUFFERS,TIMING,SUMMARY)
WITH requested_symbols AS MATERIALIZED (
    SELECT symbol_id
    FROM (
        SELECT DISTINCT f.symbol_id
        FROM feat.features_daily f
        WHERE f.feature_version='phase2-v2'
          AND f.trade_date BETWEEN DATE '2020-01-01' AND DATE '2020-03-31'
    ) selected
    ORDER BY symbol_id
    LIMIT 15
), eligible_symbols AS MATERIALIZED (
    SELECT c.symbol_id
    FROM requested_symbols c
    CROSS JOIN LATERAL (
        SELECT r.symbol_id
        FROM pg_temp.phase2_adjustment_rows r
        JOIN pg_temp.phase2_v3_sessions s ON s.trade_date=r.trade_date
        WHERE r.symbol_id=c.symbol_id
          AND r.trade_date BETWEEN
              (SELECT min(trade_date) FROM pg_temp.phase2_v3_sessions)
              AND (SELECT max(trade_date) FROM pg_temp.phase2_v3_sessions)
          AND r.source='vndirect'
          AND r.reference_adjustment_ratio>0
          AND r.reference_adjustment_ratio<'Infinity'::double precision
        LIMIT 1
    ) eligible
)
SELECT count(*) FROM eligible_symbols;

\echo ELIGIBILITY SCALE 30 INPUT SYMBOLS
EXPLAIN (ANALYZE,BUFFERS,TIMING,SUMMARY)
WITH requested_symbols AS MATERIALIZED (
    SELECT symbol_id
    FROM (
        SELECT DISTINCT f.symbol_id
        FROM feat.features_daily f
        WHERE f.feature_version='phase2-v2'
          AND f.trade_date BETWEEN DATE '2020-01-01' AND DATE '2020-03-31'
    ) selected
    ORDER BY symbol_id
    LIMIT 30
), eligible_symbols AS MATERIALIZED (
    SELECT c.symbol_id
    FROM requested_symbols c
    CROSS JOIN LATERAL (
        SELECT r.symbol_id
        FROM pg_temp.phase2_adjustment_rows r
        JOIN pg_temp.phase2_v3_sessions s ON s.trade_date=r.trade_date
        WHERE r.symbol_id=c.symbol_id
          AND r.trade_date BETWEEN
              (SELECT min(trade_date) FROM pg_temp.phase2_v3_sessions)
              AND (SELECT max(trade_date) FROM pg_temp.phase2_v3_sessions)
          AND r.source='vndirect'
          AND r.reference_adjustment_ratio>0
          AND r.reference_adjustment_ratio<'Infinity'::double precision
        LIMIT 1
    ) eligible
)
SELECT count(*) FROM eligible_symbols;

\echo ELIGIBILITY SCALE 60 INPUT SYMBOLS
EXPLAIN (ANALYZE,BUFFERS,TIMING,SUMMARY)
WITH requested_symbols AS MATERIALIZED (
    SELECT symbol_id
    FROM (
        SELECT DISTINCT f.symbol_id
        FROM feat.features_daily f
        WHERE f.feature_version='phase2-v2'
          AND f.trade_date BETWEEN DATE '2020-01-01' AND DATE '2020-03-31'
    ) selected
    ORDER BY symbol_id
    LIMIT 60
), eligible_symbols AS MATERIALIZED (
    SELECT c.symbol_id
    FROM requested_symbols c
    CROSS JOIN LATERAL (
        SELECT r.symbol_id
        FROM pg_temp.phase2_adjustment_rows r
        JOIN pg_temp.phase2_v3_sessions s ON s.trade_date=r.trade_date
        WHERE r.symbol_id=c.symbol_id
          AND r.trade_date BETWEEN
              (SELECT min(trade_date) FROM pg_temp.phase2_v3_sessions)
              AND (SELECT max(trade_date) FROM pg_temp.phase2_v3_sessions)
          AND r.source='vndirect'
          AND r.reference_adjustment_ratio>0
          AND r.reference_adjustment_ratio<'Infinity'::double precision
        LIMIT 1
    ) eligible
)
SELECT count(*) FROM eligible_symbols;

ROLLBACK;
